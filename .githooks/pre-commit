#!/bin/sh
# Pre-commit guard for this repository. Activate once per clone:
#   git config core.hooksPath .githooks
#
# Runs the machine-specific leak scan (scripts/check-clean.mjs), the doc-count
# guard (scripts/sync-doc-counts.mjs --check) and the offline unit suite. All
# must pass; the commit is rejected otherwise.
# Bypass deliberately only when you must: git commit --no-verify
set -e

echo "pre-commit: check-clean + doc counts + unit tests"
node scripts/check-clean.mjs
node scripts/sync-doc-counts.mjs --check
node --test tests/*.test.mjs
